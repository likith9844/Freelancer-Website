# ==============================================================================
# KaryaSetu (Freelancing For India) — Production Environment Configuration
# ==============================================================================

# 1. CORE APPLICATION CONFIGURATION
NODE_ENV=production
PORT=3000
APP_NAME=KaryaSetu
NEXT_PUBLIC_APP_URL=https://karyasetu.in
NEXT_PUBLIC_API_VERSION=v1

# 2. CRYPTOGRAPHY, SESSION & SENSITIVE PII ENCRYPTION
# Required: 64+ char random string for session tokens
SESSION_SECRET=ks_live_secure_jwt_session_secret_production_2026_super_key_random_seed
# Required: 32-byte hex key for AES-256-GCM bank account encryption
BANK_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
TOTP_ISSUER="KaryaSetu India"

# 3. PAYMENT GATEWAY PROVIDER ABSTRACTION
# Options: MOCK | RAZORPAY_ROUTE | CASHFREE
PAYMENT_PROVIDER_MODE=MOCK

# Razorpay Route Marketplace Credentials (if mode=RAZORPAY_ROUTE)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=ks_live_webhook_secret_razorpay_2026

# Cashfree Marketplace Split Credentials (if mode=CASHFREE)
CASHFREE_APP_ID=cf_app_xxxxxxxxxxxxxx
CASHFREE_SECRET_KEY=cf_sec_xxxxxxxxxxxxxxxxxxxxxxxx
CASHFREE_WEBHOOK_SECRET=ks_live_webhook_secret_cashfree_2026

# 4. INDIAN REGULATORY & TAX COMPLIANCE
GST_SAC_CODE=998314
PLATFORM_GSTIN=27AAECK1234F1Z5
PLATFORM_PAN=AAECK1234F
SECTION_194O_TDS_RATE=0.01
SECTION_52_GST_TCS_RATE=0.01
CGST_RATE=0.09
SGST_RATE=0.09
IGST_RATE=0.18

# 5. DLT COMPLIANT SMS GATEWAY (TRAI Regulations)
DLT_SMS_PROVIDER=MSG91
DLT_SMS_API_KEY=dlt_key_placeholder_msg91_2026
DLT_SENDER_HEADER=KARYAS
DLT_ENTITY_ID=1101552233445566778

# 6. DATABASE & STORAGE (PostgreSQL / SQLite / File persistence)
DATABASE_URL=postgresql://karyasetu:karyasetu_secure_password_2026@localhost:5432/karyasetu_db
DATA_DIR=.data/
